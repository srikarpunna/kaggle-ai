# ElderCare Agent - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: Gemini API Key (FREE)
# ============================================
# Get your FREE API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# OPTIONAL: Google Calendar API
# ============================================
# If using Google Calendar integration
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CALENDAR_CREDENTIALS_PATH=config/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=data/google_calendar_token.json

# ============================================
# Application Settings
# ============================================
# Default user for demo
DEFAULT_USER_ID=margaret_thompson

# Flask server settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Database directory
DATA_DIR=data

# Configuration directory
CONFIG_DIR=config

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/eldercare_agent.log

# ============================================
# MCP Server Settings
# ============================================
MCP_CONTACTS_PORT=3001
MCP_HEALTH_PORT=3002
MCP_CALENDAR_PORT=3003

# ============================================
# Agent Settings
# ============================================
# Model to use (options: gemini-2.0-flash-exp, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash-exp

# Temperature for LLM (0.0 - 1.0)
LLM_TEMPERATURE=0.7

# Max tokens for LLM responses
LLM_MAX_TOKENS=1024

# ============================================
# UI Settings
# ============================================
# Enable speech recognition
ENABLE_SPEECH_RECOGNITION=True

# Enable text-to-speech
ENABLE_TEXT_TO_SPEECH=True

# UI language
UI_LANGUAGE=en-US

# ============================================
# Medication Reminder Settings
# ============================================
# Check interval for medication reminders (seconds)
MEDICATION_CHECK_INTERVAL=60

# Advance notice for reminders (minutes)
MEDICATION_REMINDER_ADVANCE=5

# ============================================
# Deployment (for Cloud Run)
# ============================================
PORT=8080
